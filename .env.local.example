# Copie este arquivo para .env.local e preencha com suas chaves reais.
# .env.local nunca deve ser commitado (já está no .gitignore padrão do Next.js).

# URL pública do site (usada nos redirects do Stripe Checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price ID (modo pagamento único) da oferta "Carbmaxxing ELITE"
STRIPE_PRICE_ID_ELITE=
# Webhook signing secret (Developers > Webhooks > sua rota /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# --- Supabase da área de membros (projeto "carbb", carbmaxxing.vercel.app) ---
# Usado por /api/enroll e /api/stripe/webhook pra criar a conta do aluno lá
# (via Admin API, sem e-mail de confirmação — ver src/lib/carbb.ts).
# Copie do .env.local do projeto carbb: NEXT_PUBLIC_SUPABASE_URL vira
# CARBB_SUPABASE_URL, e SUPABASE_SERVICE_ROLE_KEY vira
# CARBB_SUPABASE_SERVICE_ROLE_KEY.
CARBB_SUPABASE_URL=
CARBB_SUPABASE_SERVICE_ROLE_KEY=

# URL pública da área de membros — usada no botão "Entrar" da tela de
# sucesso (/planilhadohack/obrigado).
NEXT_PUBLIC_CARBB_APP_URL=https://carbmaxxing.vercel.app
