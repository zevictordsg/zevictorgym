# Copie este arquivo para .env.local e preencha com suas chaves reais.
# .env.local nunca deve ser commitado (já está no .gitignore padrão do Next.js).

# URL pública do site (usada nos redirects do Stripe Checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price ID (modo pagamento único) da oferta "Carbmaxxing ELITE"
STRIPE_PRICE_ID_ELITE=
# Webhook signing secret (Developers > Webhooks) — usado quando criarmos
# a rota /api/stripe/webhook para confirmar pagamentos automaticamente
STRIPE_WEBHOOK_SECRET=
